# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
APP_NAME=kfc-userapi
APP_VERSION=1.0.0
APP_ENV=development          # development | staging | production
APP_DEBUG=true

# ─────────────────────────────────────────────────────────────
# Logger
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=debug              # debug | info | warn | error
LOG_FORMAT=text              # text | json
LOG_OUTPUT=stdout            # stdout | file | both
LOG_FILE_PATH=logs/app.log
LOG_SERVICE=kfc-userapi

# ─────────────────────────────────────────────────────────────
# HTTP
# ─────────────────────────────────────────────────────────────
HTTP_PORT=8001
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# Browser origins: kiosk, website, KDS, hall display
CORS_ALLOW_ORIGINS=http://localhost:4300,http://localhost:4400,http://localhost:4500,http://localhost:4600
# Web checkouts per client IP per minute
PUBLIC_ORDER_RATE_LIMIT=10

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_CONNECT_TIMEOUT=5s
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ─────────────────────────────────────────────────────────────
# Device tokens
# ─────────────────────────────────────────────────────────────
JWT_DEVICE_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_DEVICE_TTL=168h
JWT_ISSUER=kfc-userapi

# ─────────────────────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:29092
KAFKA_GROUP_ID=kfc-userapi
KAFKA_MENU_TOPIC=crm.menu.updated
KAFKA_ORDERS_TOPIC=orders.events

# ─────────────────────────────────────────────────────────────
# Upstream services (gRPC)
# ─────────────────────────────────────────────────────────────
CRM_GRPC_ADDRESS=localhost:9100
CRM_GRPC_TIMEOUT=5s
ORDER_GRPC_ADDRESS=localhost:9103
ORDER_GRPC_TIMEOUT=5s
